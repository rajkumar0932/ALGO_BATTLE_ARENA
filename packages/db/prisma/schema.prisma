// AlgoBattle Prisma Schema
// Models: User, Problem, TestCase, Battle, Submission

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BattleStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum RoomStatus {
  OPEN
  FULL
  STARTED
  FINISHED
  EXPIRED
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  rating       Int      @default(1200)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  battlesAsPlayer1 Battle[]       @relation("Player1Battles")
  battlesAsPlayer2 Battle[]       @relation("Player2Battles")
  battlesWon       Battle[]       @relation("WinnerBattles")
  submissions      Submission[]
  botBattles       BotBattle[]
  hostedRooms      PrivateRoom[]  @relation("HostRoom")
  joinedRooms      PrivateRoom[]  @relation("GuestRoom")

  @@map("users")
}

// ─── Problem ─────────────────────────────────────────────

model Problem {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  difficulty  Difficulty
  starterCode String     @db.Text
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  testCases    TestCase[]
  battles      Battle[]
  botBattles   BotBattle[]
  interviews   ProblemInterview[]
  privateRooms PrivateRoom[]

  @@map("problems")
}

// ─── TestCase ────────────────────────────────────────────

model TestCase {
  id        String  @id @default(cuid())
  input     String  @db.Text
  expected  String  @db.Text
  isHidden  Boolean @default(false)
  order     Int     @default(0)

  // Relations
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

// ─── Battle ──────────────────────────────────────────────

model Battle {
  id           String       @id @default(cuid())
  status       BattleStatus @default(WAITING)
  timeLimitSec Int          @default(600) // 10 minutes
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  startedAt    DateTime?
  endedAt      DateTime?

  // Game state
  player1Id String
  player1   User   @relation("Player1Battles", fields: [player1Id], references: [id])

  player2Id String?
  player2   User?  @relation("Player2Battles", fields: [player2Id], references: [id])

  winnerId String?
  winner   User?  @relation("WinnerBattles", fields: [winnerId], references: [id])

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])

  submissions Submission[]

  @@map("battles")
}

// ─── Submission ──────────────────────────────────────────

model Submission {
  id              String   @id @default(cuid())
  code            String   @db.Text
  language        String   @default("javascript")
  verdict         Verdict  @default(PENDING)
  passedCases     Int      @default(0)
  totalCases      Int      @default(0)
  executionTimeMs Int?
  submittedAt     DateTime @default(now())

  // Relations
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("submissions")
}

// ─── BotBattle ───────────────────────────────────────────

model BotBattle {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id])
  
  botTier         String
  botElo          Int
  
  userCode        String?  @db.Text
  userLanguage    String   @default("javascript")
  botCode         String?  @db.Text
  botLanguage     String   @default("javascript")
  
  userVerdict     Verdict?
  botVerdict      Verdict
  
  userPassedCases Int      @default(0)
  userTotalCases  Int      @default(0)
  botPassedCases  Int      @default(0)
  botTotalCases   Int      @default(0)
  
  userTimeTakenMs Int?
  botTimeTakenMs  Int
  
  winnerId        String?
  eloDelta        Int      @default(0)
  
  timeLimitSec    Int      @default(600)
  createdAt       DateTime @default(now())

  @@map("bot_battles")
}

// ─── PrivateRoom ─────────────────────────────────────────

model PrivateRoom {
  id          String     @id @default(cuid())
  code        String     @unique // 6 chars
  hostId      String
  host        User       @relation("HostRoom", fields: [hostId], references: [id])
  guestId     String?
  guest       User?      @relation("GuestRoom", fields: [guestId], references: [id])
  
  problemId   String?
  problem     Problem?   @relation(fields: [problemId], references: [id])
  
  battleId    String?
  
  status      RoomStatus @default(OPEN)
  timeLimit   Int        @default(1800)
  scoringMode String     @default("standard")
  isRanked    Boolean    @default(false)
  
  createdAt   DateTime   @default(now())
  expiresAt   DateTime

  @@map("private_rooms")
}

// ─── ProblemInterview ────────────────────────────────────

model ProblemInterview {
  id          String   @id @default(cuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  company     String
  role        String?
  round       String?
  date        DateTime?
  frequency   Int      @default(1)
  source      String?
  year        Int?
  createdAt   DateTime @default(now())

  @@map("problem_interviews")
}
